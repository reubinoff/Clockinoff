DATABASE_URL=postgres://timely:timely@localhost:5432/timely
DATABASE_URL_TEST=postgres://timely:timely@localhost:5432/timely_test
NEXTAUTH_SECRET=change-me-please-32-bytes-min-secret-string
NEXTAUTH_URL=http://localhost:3000
NODE_ENV=development

# Azure Postgres Entra / Managed Identity auth (#75).
# Leave unset for local dev / password rollback. When `DATABASE_URL` is
# passwordless (e.g. `postgresql://clockinoff-prod@host:5432/db?sslmode=require`)
# the app auto-detects AAD mode. Set `PG_AZURE_AD_AUTH=1` to force token
# auth, or `PG_AZURE_AD_AUTH=0` to force the static password path even if
# the URL happens to be passwordless. Tokens are minted for the
# `https://ossrdbms-aad.database.windows.net/.default` scope. The runtime
# pool uses `DefaultAzureCredential` (binds to the App Service system MI,
# role `clockinoff-prod`, DML-only), while startup migrations use the
# migrator UAMI below.
PG_AZURE_AD_AUTH=
# Migrator user-assigned managed identity clientId. REQUIRED when
# `PG_AZURE_AD_AUTH` is on: `scripts/migrate.mjs` authenticates to
# Postgres as this UAMI (e.g. `uami-clockinoff-migrator` in prod — the
# only Entra role with DDL grants on database `clockinoff`). Leave unset
# in dev / password mode. Clockinoff #75 made this contract hard — missing
# the var under AAD mode fails fast with a clear error instead of letting
# the migrate step connect as the DML-only system MI and crash-loop on
# `42501 permission denied for schema public`.
PG_MIGRATOR_CLIENT_ID=
# Postgres role name the migrate step authenticates as under
# `PG_AZURE_AD_AUTH=1`. Defaults to `uami-clockinoff-migrator` — the
# exact Entra Postgres role whose security-label OID matches the migrator
# UAMI's token. Override only when the migrator role is named differently
# (e.g. a non-prod environment). Must NOT be the runtime `clockinoff-prod`
# role: Ariel's prod probe showed Azure Postgres rejects a UAMI token
# combined with `user=clockinoff-prod` with SQLSTATE `28000` (principal id
# mismatch), because the `clockinoff-prod` role is labelled with the
# system MI's OID. The runtime pool keeps the URL's `clockinoff-prod`.
PG_MIGRATOR_PG_USER=

# Google OAuth — "Continue with Google" on /login + /register.
# Production uses Key Vault refs on the clockinoff-prod App Service; for
# local dev point these at a test OAuth client that has an authorised
# redirect URI matching GOOGLE_REDIRECT_URI (or the derived default,
# `<NEXTAUTH_URL>/api/auth/google/callback`). Leave blank to disable the
# button path (/api/auth/google/start will fail-closed to /login?error=network).
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Optional override. When unset we derive the URI from NEXTAUTH_URL.
# Production value is https://clockinoff.reubinoff.com/api/auth/google/callback
GOOGLE_REDIRECT_URI=
