DATABASE_URL=postgres://timely:timely@localhost:5432/timely
DATABASE_URL_TEST=postgres://timely:timely@localhost:5432/timely_test
NEXTAUTH_SECRET=change-me-please-32-bytes-min-secret-string
NEXTAUTH_URL=http://localhost:3000
NODE_ENV=development

# Azure Postgres Entra / Managed Identity auth (#75 phase 1).
# Leave unset for local dev / password rollback. When `DATABASE_URL` is
# passwordless (e.g. `postgresql://clockinoff-prod@host:5432/db?sslmode=require`)
# the app auto-detects AAD mode. Set `PG_AZURE_AD_AUTH=1` to force token
# auth, or `PG_AZURE_AD_AUTH=0` to force the static password path even if
# the URL happens to be passwordless. Tokens are minted via
# `DefaultAzureCredential` for the
# `https://ossrdbms-aad.database.windows.net/.default` scope.
PG_AZURE_AD_AUTH=

# Google OAuth — "Continue with Google" on /login + /register.
# Production uses Key Vault refs on the clockinoff-prod App Service; for
# local dev point these at a test OAuth client that has an authorised
# redirect URI matching GOOGLE_REDIRECT_URI (or the derived default,
# `<NEXTAUTH_URL>/api/auth/google/callback`). Leave blank to disable the
# button path (/api/auth/google/start will fail-closed to /login?error=network).
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Optional override. When unset we derive the URI from NEXTAUTH_URL.
# Production value is https://clockinoff.reubinoff.com/api/auth/google/callback
GOOGLE_REDIRECT_URI=
