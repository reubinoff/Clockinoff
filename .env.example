# Local dev omits sslmode (loopback is exempt from the production guard).
# Production Key Vault / App Setting must use sslmode=verify-full.
DATABASE_URL=postgres://timely:timely@localhost:5432/timely
DATABASE_URL_TEST=postgres://timely:timely@localhost:5432/timely_test
NEXTAUTH_SECRET=change-me-please-32-bytes-min-secret-string
NEXTAUTH_URL=http://localhost:3000
NODE_ENV=development
# HMAC key for the Google OAuth state cookie. Required in production
# (boot and /api/health fail closed if unset or shorter than 32 bytes).
# The placeholder below is 11 bytes on purpose so it cannot be used as-is.
# Never reuse NEXTAUTH_SECRET.
OAUTH_STATE_SECRET=placeholder

# Azure Postgres Entra / Managed Identity auth (#75).
# Leave unset for local dev / password rollback. When `DATABASE_URL` is
# passwordless (e.g. `postgresql://<runtime-role>@<pg-host>:5432/<db>?sslmode=verify-full`)
# the app auto-detects AAD mode. Set `PG_AZURE_AD_AUTH=1` to force token
# auth, or `PG_AZURE_AD_AUTH=0` to force the static password path even if
# the URL happens to be passwordless. Tokens are minted for the
# Azure Postgres Entra scope (`<aad-postgres-scope>`). The runtime
# pool uses `DefaultAzureCredential` (binds to the App Service system MI,
# role `<runtime-role>`, DML-only), while startup migrations use the
# migrator UAMI below.
PG_AZURE_AD_AUTH=
# Migrator user-assigned managed identity clientId. REQUIRED when
# `PG_AZURE_AD_AUTH` is on: `scripts/migrate.mjs` authenticates to
# Postgres as this UAMI (`<migrator-uami>` — the Entra role with
# DDL grants). Leave unset in dev / password mode. Clockinoff #75
# made this contract hard — missing the var under AAD mode fails
# fast with a clear error instead of letting the migrate step
# connect as the DML-only system MI.
PG_MIGRATOR_CLIENT_ID=
# Postgres role name the migrate step authenticates as under
# `PG_AZURE_AD_AUTH=1`. Required in production (no hardcoded default
# on that path). Non-production may omit it. Must NOT be the runtime
# `<runtime-role>`: the Entra principal in the token must match the
# Postgres role. The runtime pool keeps the URL's `<runtime-role>`.
#
# Production DATABASE_URL must use sslmode=verify-full. The app refuses
# to start in production when sslmode is disable, no-verify, or missing
# (loopback hosts are exempt). Nati flips the Key Vault / App Setting
# value; do not put a real connection string here.
PG_MIGRATOR_PG_USER=

# Google OAuth — "Continue with Google" on /login + /register.
# Production uses Key Vault refs on the `<webapp>` App Service; for
# local dev point these at a test OAuth client that has an authorised
# redirect URI matching GOOGLE_REDIRECT_URI (or the derived default,
# `<NEXTAUTH_URL>/api/auth/google/callback`). Leave blank to disable the
# button path (/api/auth/google/start will fail-closed to /login?error=network).
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Optional override. When unset we derive the URI from NEXTAUTH_URL.
# Production value is `<prod-callback>`
GOOGLE_REDIRECT_URI=
